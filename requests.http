@baseUrl = http://localhost:3000
@accessToken = REPLACE_WITH_ACCESS_TOKEN
@appointmentId = REPLACE_WITH_APPOINTMENT_ID

### Health
GET {{baseUrl}}/api/health

### Register patient
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "Abebe Kebede",
  "email": "ABEBE@example.com",
  "password": "StrongPass1!",
  "phone": "+251911234567"
}

### Login patient
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "abebe@example.com",
  "password": "StrongPass1!"
}

### Refresh (requires refresh cookie from login/register)
POST {{baseUrl}}/api/auth/refresh

### Create appointment
POST {{baseUrl}}/api/appointments
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "department": "GENERAL_PRACTICE",
  "appointmentDate": "2026-09-10T10:30:00.000Z",
  "symptoms": "Persistent headache for three days",
  "isEmergency": false
}

### List own appointments
GET {{baseUrl}}/api/appointments
Authorization: Bearer {{accessToken}}

### List with filters
GET {{baseUrl}}/api/appointments?department=GENERAL_PRACTICE&status=PENDING&isEmergency=false&search=headache
Authorization: Bearer {{accessToken}}

### Get appointment
GET {{baseUrl}}/api/appointments/{{appointmentId}}
Authorization: Bearer {{accessToken}}

### Update appointment
PATCH {{baseUrl}}/api/appointments/{{appointmentId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "symptoms": "Headache has continued for five days"
}

### Cancel own pending appointment
DELETE {{baseUrl}}/api/appointments/{{appointmentId}}
Authorization: Bearer {{accessToken}}

### Doctor login (seed first)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "doctor@carepoint.local",
  "password": "DoctorPassword1!"
}

### Admin metrics (replace token with admin access token)
GET {{baseUrl}}/api/admin/metrics
Authorization: Bearer ADMIN_ACCESS_TOKEN

### Start Google OAuth in browser
GET {{baseUrl}}/api/auth/google
